<% layout('admin/layout') -%>

<div class="space-y-6">
    <section class="bg-white p-8 rounded-xl shadow-sm border border-gray-100">
        <div class="flex items-center gap-4">
            <div class="bg-[#1b5c40] p-3 rounded-lg text-white">
                <i class="fas fa-terminal text-2xl"></i>
            </div>

            <div>
                <div class="flex items-center gap-3 flex-wrap">
                    <h1 class="text-3xl font-bold text-gray-800">
                        Integração e Catálogo de Dados
                    </h1>

                    <span class="text-sm font-normal bg-blue-100 text-blue-700 px-2 py-1 rounded">
                        v2.1.0
                    </span>
                </div>

                <p class="text-gray-500 pt-2">
                    Monitoramento dos endpoints JSON e Conteúdo Dinâmico (CMS).
                </p>
            </div>
        </div>
    </section>
    <% if (
        typeof uploadJsonSuccess !== 'undefined'
        && uploadJsonSuccess
    ) { %>

        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg">
            <div class="flex items-center gap-2">
                <i class="fas fa-check-circle"></i>

                <div>
                    <strong>Sucesso:</strong>

                    <% if (
                        typeof uploadedJson !== 'undefined'
                        && uploadedJson
                    ) { %>

                        o arquivo
                        <span class="font-mono font-bold">
                            <%= uploadedJson %>
                        </span>
                        foi substituído com sucesso.

                    <% } else { %>

                        o arquivo JSON foi substituído com sucesso.

                    <% } %>
                </div>
            </div>
        </div>

    <% } %>

    <% if (
        typeof uploadJsonError !== 'undefined'
        && uploadJsonError
    ) { %>

        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg">
            <div class="flex items-start gap-2">
                <i class="fas fa-exclamation-circle mt-1"></i>

                <div>
                    <strong>Erro ao substituir JSON:</strong>
                    <%= uploadJsonError %>
                </div>
            </div>
        </div>

    <% } %>

    <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
        <div class="flex items-start justify-between gap-4 mb-6">
            <div>
                <h2 class="text-xl font-bold text-gray-800">
                    Atualizar base JSON
                </h2>

                <p class="text-sm text-gray-500 mt-1">
                    Substitua um dos arquivos JSON utilizados pelos endpoints da API.
                </p>
            </div>

            <div class="bg-[#1b5c40] text-white rounded-lg p-3">
                <i class="fas fa-file-code text-xl"></i>
            </div>
        </div>

        <form action="/admin/data/upload-json" method="POST" enctype="multipart/form-data" class="space-y-5">
            <div>
                <label for="targetFile" class="block text-sm font-bold text-gray-700 mb-2">
                    Base que será atualizada
                </label>

                <select id="targetFile" name="targetFile" required class="w-full border border-gray-300 rounded-lg px-4 py-2 bg-white text-gray-700 focus:outline-none focus:ring-2 focus:ring-[#1b5c40]">
                    <option value="">
                        Selecione o arquivo de destino
                    </option>

                    <option value="frota_tabela.json">
                        frota_tabela.json
                    </option>

                    <option value="simulacao_monte_carlo.json">
                        simulacao_monte_carlo.json
                    </option>

                    <option value="mapas_distritos.json">
                        mapas_distritos.json
                    </option>

                </select>
                <p class="text-xs text-gray-400 mt-2">
                    Selecione qual arquivo atualmente utilizado pela API será substituído.
                </p>
            </div>

            <div>

                <label for="jsonFile" class="block text-sm font-bold text-gray-700 mb-2">
                    Novo arquivo JSON
                </label>

                <input id="jsonFile" type="file"name="jsonFile"accept=".json,application/json"required class="flex min-h-10 w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-400 file:border-0 file:bg-transparent file:text-gray-600 file:text-sm file:font-medium" >

            </div>


            <!-- EXPLICAÇÃO -->

            <div class="bg-blue-50 border border-blue-100 text-blue-800 rounded-lg p-4 text-sm">

                <div class="flex items-start gap-3">

                    <i class="fas fa-shield-alt mt-1"></i>

                    <div>
                        <p class="font-bold mb-2">
                            Validação automática
                        </p>

                        <p>
                            O sistema aceita somente arquivos com extensão
                            <code class="bg-white px-1 rounded">.json</code>.
                        </p>

                        <p class="mt-2">
                            Antes da substituição, o conteúdo será validado para
                            confirmar que contém um JSON válido.
                        </p>

                        <p class="mt-2">
                            O arquivo atualmente utilizado pela API será salvo
                            em backup antes da substituição.
                        </p>
                    </div>

                </div>

            </div>


            <!-- AVISO GEOJSON -->

            <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-lg p-4 text-sm">

                <div class="flex items-start gap-3">

                    <i class="fas fa-info-circle mt-1"></i>

                    <div>
                        <p class="font-bold mb-1">
                            Arquivos GeoJSON não são alterados aqui
                        </p>

                        <p>
                            Os arquivos
                            <code class="bg-white px-1 rounded">frota_pontos.geojson</code>
                            e
                            <code class="bg-white px-1 rounded">frota_rotas.geojson</code>
                            permanecem somente para monitoramento.
                        </p>
                    </div>

                </div>

            </div>


            <!-- BOTÃO -->

            <button
                type="submit"
                class="w-full bg-[#1b5c40] hover:bg-[#0f3d17] text-white px-6 py-3 rounded-lg font-bold transition-all shadow-md active:scale-[0.99]"
            >

                <i class="fas fa-upload text-xs mr-2"></i>

                Substituir arquivo JSON

            </button>

        </form>

    </section>


    <!-- ====================================================== -->
    <!-- STATUS DOS ARQUIVOS -->
    <!-- ====================================================== -->

    <section>

        <div class="mb-4">
            <h2 class="text-xl font-bold text-gray-800">
                Status das bases
            </h2>

            <p class="text-sm text-gray-500 mt-1">
                Arquivos atualmente utilizados pelos endpoints da aplicação.
            </p>
        </div>


        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">


            <!-- ================================================== -->
            <!-- DADOS TABULARES -->
            <!-- ================================================== -->

            <article class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">

                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 border-b pb-2">

                    <i class="fas fa-table text-[#1b5c40]"></i>

                    Dados Tabulares & Analíticos

                </h3>


                <ul class="space-y-3">


                    <!-- FROTA TABELA -->

                    <li class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition">

                        <div>

                            <div class="font-bold text-gray-700 text-sm">
                                frota_tabela.json
                            </div>

                            <div class="text-xs text-gray-400">
                                Dados consolidados para tabelas
                            </div>

                        </div>


                        <% if (filesStatus['frota_tabela.json']) { %>

                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full border border-green-200">
                                ONLINE
                            </span>

                        <% } else { %>

                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full border border-red-200">
                                OFFLINE
                            </span>

                        <% } %>

                    </li>


                    <!-- SIMULAÇÃO MONTE CARLO -->

                    <li class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition">

                        <div>

                            <div class="font-bold text-gray-700 text-sm">
                                simulacao_monte_carlo.json
                            </div>

                            <div class="text-xs text-gray-400">
                                Previsões estatísticas futuras
                            </div>

                        </div>


                        <% if (filesStatus['simulacao_monte_carlo.json']) { %>

                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full border border-green-200">
                                ONLINE
                            </span>

                        <% } else { %>

                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full border border-red-200">
                                OFFLINE
                            </span>

                        <% } %>

                    </li>

                </ul>

            </article>


            <!-- ================================================== -->
            <!-- GEOESPACIAL -->
            <!-- ================================================== -->

            <article class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">

                <h3 class="text-lg font-bold text-gray-800 mb-4 flex items-center gap-2 border-b pb-2">

                    <i class="fas fa-map-marked-alt text-[#1b5c40]"></i>

                    Camada Geoespacial (Mapas)

                </h3>


                <ul class="space-y-3">


                    <!-- FROTA PONTOS -->

                    <li class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition">

                        <div>

                            <div class="font-bold text-gray-700 text-sm">
                                frota_pontos.geojson
                            </div>

                            <div class="text-xs text-gray-400">
                                Pontos em tempo real & Heatmap
                            </div>

                        </div>


                        <% if (filesStatus['frota_pontos.geojson']) { %>

                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full border border-green-200">
                                ONLINE
                            </span>

                        <% } else { %>

                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full border border-red-200">
                                OFFLINE
                            </span>

                        <% } %>

                    </li>


                    <!-- FROTA ROTAS -->

                    <li class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition">

                        <div>

                            <div class="font-bold text-gray-700 text-sm">
                                frota_rotas.geojson
                            </div>

                            <div class="text-xs text-gray-400">
                                Traçados viários (Elétrico vs Diesel)
                            </div>

                        </div>


                        <% if (filesStatus['frota_rotas.geojson']) { %>

                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full border border-green-200">
                                ONLINE
                            </span>

                        <% } else { %>

                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full border border-red-200">
                                OFFLINE
                            </span>

                        <% } %>

                    </li>


                    <!-- MAPAS DISTRITOS -->

                    <li class="flex items-center justify-between p-2 hover:bg-gray-50 rounded transition">

                        <div>

                            <div class="font-bold text-gray-700 text-sm">
                                mapas_distritos.json
                            </div>

                            <div class="text-xs text-gray-400">
                                Mapa político de distritos
                            </div>

                        </div>


                        <% if (filesStatus['mapas_distritos.json']) { %>

                            <span class="px-2 py-1 text-xs font-bold text-green-700 bg-green-100 rounded-full border border-green-200">
                                ONLINE
                            </span>

                        <% } else { %>

                            <span class="px-2 py-1 text-xs font-bold text-red-700 bg-red-100 rounded-full border border-red-200">
                                OFFLINE
                            </span>

                        <% } %>

                    </li>

                </ul>

            </article>

        </div>

    </section>


    <!-- ====================================================== -->
    <!-- CATÁLOGO DE ENDPOINTS -->
    <!-- ====================================================== -->

    <section>

        <div class="mb-4">

            <h2 class="text-xl font-bold text-gray-800">
                Catálogo de endpoints
            </h2>

            <p class="text-sm text-gray-500 mt-1">
                Rotas disponíveis para consulta dos dados processados.
            </p>

        </div>


        <div class="space-y-4">

            <% endpoints.forEach((ep, index) => { %>

                <article
                    class="group bg-white rounded-lg border border-gray-200 overflow-hidden hover:shadow-md transition-all"
                >

                    <button
                        type="button"
                        onclick="toggleDetails('ep-<%= index %>')"
                        class="w-full flex items-center justify-between p-4 focus:outline-none"
                    >

                        <div class="flex items-center gap-4 min-w-0">

                            <span
                                class="px-3 py-1 rounded font-bold text-sm <%= ep.method === 'GET' ? 'bg-blue-500 text-white' : 'bg-green-500 text-white' %>"
                            >
                                <%= ep.method %>
                            </span>

                            <span class="font-mono text-gray-700 font-semibold break-all">
                                <%= ep.path %>
                            </span>

                            <span class="text-gray-400 text-sm hidden md:inline">
                                — <%= ep.desc %>
                            </span>

                        </div>


                        <div class="flex items-center gap-3 ml-4">

                            <% if (ep.status) { %>

                                <span class="flex items-center gap-1 text-xs text-green-600 font-bold bg-green-50 px-2 py-1 rounded">

                                    <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>

                                    PRONTO

                                </span>

                            <% } else { %>

                                <span class="text-xs text-red-600 font-bold bg-red-50 px-2 py-1 rounded">
                                    PENDENTE
                                </span>

                            <% } %>


                            <i
                                class="fas fa-chevron-down text-gray-300 group-hover:text-gray-500 transition-transform"
                                id="icon-<%= index %>"
                            ></i>

                        </div>

                    </button>


                    <!-- DETALHES DO ENDPOINT -->

                    <div
                        id="ep-<%= index %>"
                        class="hidden border-t border-gray-100 bg-gray-50 p-6 space-y-4"
                    >

                        <div>

                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                                Descrição
                            </h4>

                            <p class="text-gray-700">
                                <%= ep.desc %>
                            </p>

                        </div>


                        <div>

                            <h4 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-2">
                                Exemplo de Resposta (JSON)
                            </h4>

                            <div class="bg-[#1e1e1e] p-4 rounded-lg overflow-x-auto text-sm leading-relaxed">

                                <pre class="text-blue-300"><code><%= JSON.stringify(ep.response, null, 2) %></code></pre>

                            </div>

                        </div>


                        <div class="flex justify-end">

                            <a
                                href="<%= ep.path %>"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-bold text-[#1b5c40] hover:underline flex items-center gap-2"
                            >

                                <i class="fas fa-external-link-alt"></i>

                                Testar rota no navegador

                            </a>

                        </div>

                    </div>

                </article>

            <% }) %>

        </div>

    </section>


    <!-- ====================================================== -->
    <!-- ENGINE DE DADOS -->
    <!-- ====================================================== -->

    <section class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">

        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">

            <div>

                <h3 class="text-lg font-bold text-gray-800">
                    Engine de Dados v2.0
                </h3>

                <p class="text-sm text-gray-500 mt-1">
                    Executa scripts Python para atualizar mapas, rotas e tabelas.
                </p>

            </div>


            <button
                id="btnRunEngine"
                type="button"
                onclick="runPipeline()"
                class="flex items-center justify-center gap-2 bg-[#1b5c40] hover:bg-[#0f3d17] text-white px-6 py-2 rounded-lg font-bold transition-all shadow-md active:scale-95"
            >

                <i class="fas fa-play text-xs"></i>

                <span>
                    Executar Pipeline Completo
                </span>

            </button>

        </div>

    </section>

</div>


<!-- ========================================================== -->
<!-- JAVASCRIPT DA PÁGINA -->
<!-- ========================================================== -->

<script>

    function toggleDetails(id) {

        const element = document.getElementById(id);

        if (!element) {
            return;
        }

        const index = id.split('-')[1];

        const icon = document.getElementById(
            `icon-${index}`
        );

        element.classList.toggle('hidden');

        if (icon) {
            icon.classList.toggle('rotate-180');
        }
    }


    async function runPipeline() {

        const btn = document.getElementById(
            'btnRunEngine'
        );

        if (!btn) {
            return;
        }

        const originalContent = btn.innerHTML;

        btn.disabled = true;

        btn.innerHTML = `
            <i class="fas fa-spinner animate-spin"></i>
            <span>Processando Mapas e Dados...</span>
        `;

        btn.classList.add(
            'opacity-50',
            'cursor-not-allowed'
        );


        try {

            const response = await fetch(
                '/admin/run-engine',
                {
                    method: 'POST'
                }
            );


            const result = await response.json();


            if (result.success) {

                alert(
                    'Sucesso: ' + result.message
                );

                window.location.reload();

                return;
            }


            alert(
                'Erro: ' +
                (
                    result.message
                    || 'Não foi possível executar o pipeline.'
                )
            );


        } catch (error) {

            console.error(
                'Erro ao executar pipeline:',
                error
            );

            alert(
                'Erro de conexão com o servidor.'
            );


        } finally {

            btn.disabled = false;

            btn.innerHTML = originalContent;

            btn.classList.remove(
                'opacity-50',
                'cursor-not-allowed'
            );
        }
    }

</script>